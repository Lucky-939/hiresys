generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  password      String?
  emailVerified DateTime?
  name          String
  role          Role                 @default(USER)
  organizations OrganizationMember[] 
  interviews    Interview[]          
  candidates    Candidate[]          
  candidateDecisions Candidate[]     @relation("CandidateDecisionBy")
  createdInvites OrgInvite[]
  notifications Notification[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([email])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  desc      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(FREE)
  members   OrganizationMember[]
  interviews Interview[]
  candidates Candidate[]
  invites   OrgInvite[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole      @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model OrgInvite {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  role           OrgRole      @default(MEMBER)
  token          String       @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdById    String

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation(fields: [createdById], references: [id])

  createdAt      DateTime     @default(now())

  @@unique([email, organizationId])
  @@index([token])
}

model Interview {
  id             String          @id @default(cuid())
  title          String
  description    String?
  status         InterviewStatus @default(SCHEDULED)
  scheduledAt    DateTime?
  organizationId String
  createdById    String
  codeSubmitted  String?         @db.Text
  language       String?
  interviewNotes String?         @db.Text
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User            @relation(fields: [createdById], references: [id])
  candidateId    String?
  candidate      Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  report         InterviewReport?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum InterviewStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Recommendation {
  STRONG_HIRE
  HIRE
  MAYBE
  NO_HIRE
}

model InterviewReport {
  id                      String         @id @default(cuid())
  interviewId             String         @unique
  interview               Interview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  codingScore             Int
  problemSolvingScore     Int
  technicalKnowledgeScore Int
  overallScore            Int
  recommendation          Recommendation
  aiSummary               String
  strengths               String[]
  improvements            String[]
  generationTimeMs        Int?
  version                 Int            @default(1)

  // Immutable snapshots — capture exact interview state at report generation time
  snapshotInterviewTitle  String?
  snapshotCodeSubmitted   String?
  snapshotLanguage        String?
  snapshotQuestions       Json?
  snapshotResumeScore     Int?
  snapshotInterviewNotes  String?        @db.Text

  createdAt               DateTime       @default(now())
}

enum CandidateStage {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
}

model Candidate {
  id              String            @id @default(cuid())
  
  name            String
  email           String
  phone           String?
  linkedinUrl     String?
  
  stage           CandidateStage    @default(APPLIED)
  
  resumeText      String?
  resumeScore     Int?
  atsScore        Int?
  
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  createdById     String
  createdBy       User              @relation(fields: [createdById], references: [id])
  
  interviews      Interview[]
  activities      CandidateActivity[]
  
  decisionNotes   String?           @db.Text
  decisionById    String?
  decisionAt      DateTime?
  decisionBy      User?             @relation("CandidateDecisionBy", fields: [decisionById], references: [id])
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([createdAt])
}

model CandidateActivity {
  id          String   @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime @default(now())

  @@index([candidateId])
}